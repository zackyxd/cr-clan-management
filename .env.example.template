# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here_for_testing

# PostgreSQL Database
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGDATABASE=cr_bot_dev
PGHOST=localhost
PGPORT=5432

# Clash Royale API
CR_API_KEY=your_clash_royale_api_key_here

# Redis (if you're using BullMQ/queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Race Tracking Scheduler (Optional)
# How often the scheduler checks for pending nudges (in seconds)
# Default: 60 (checks every minute)
# For testing: Set to 10 or 30 to speed up checks
# For production: Leave commented out or set to 60
# NUDGE_SCHEDULER_INTERVAL_SECONDS=60

# 20 Win Challenge tracker (Optional - disabled unless guild, channel and roles are set)
# TWENTY_WINS_GUILD_ID=
# TWENTY_WINS_CHANNEL_ID=
# Comma-separated role IDs; members with any of them are tracked
# TWENTY_WINS_ROLE_IDS=role_id_1,role_id_2
# Battle log eventTag of the current 20 Win Challenge (default #2CJUG2VL)
# TWENTY_WINS_EVENT_TAG=

# Add any other environment variables your bot needs below
# ...
